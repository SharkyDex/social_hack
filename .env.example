# Copy this file to .env (in the repo root) and fill it in.
# .env is git-ignored — never commit real keys.

# ── AI ──────────────────────────────────────────────
# Groq key(s). Leave empty to run in MOCK mode (scripted calls, no AI) —
# useful offline and as a demo fallback.
# Several keys? Separate them with commas. Requests rotate across them and
# skip any key that hits its rate limit, so you get each key's limit added up:
#   GROQ_API_KEY=gsk_first,gsk_second,gsk_third
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Phone calls & texts ─────────────────────────────
# simulated = everything happens in the app (no phone service, $0)
# twilio    = PLACEHOLDER — not implemented yet, see server/src/telephony/twilio.js
TELEPHONY_PROVIDER=simulated

# Safety net for live calling: when a real provider is on, EVERY outbound
# call and text goes to this number instead of the person's number.
DEMO_PHONE_NUMBER=

# Incoming calls ring this number first (meant to be 911 / the local PSAP).
# NEVER put 911 here while testing — use a teammate's phone.
INBOUND_FORWARD_NUMBER=
INBOUND_FORWARD_TIMEOUT_SECONDS=20

# Twilio placeholders (unused until the twilio provider is built)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=

# ── Welfare check behaviour ─────────────────────────
# voice = call people (texts only for Deaf / non-verbal)
# sms   = text everyone first — after an earthquake, texts often get through when calls don't
FIRST_CONTACT=voice
MAX_CALL_ATTEMPTS=3
# Seconds between retries. Short for the demo; minutes in real life.
RETRY_DELAY_SECONDS=8
# Reach the emergency contact after this many failed attempts.
CONTACT_EMERGENCY_AFTER_ATTEMPT=1
# How many welfare checks run at once during a round.
CHECK_CONCURRENCY=2
# Speed up simulated conversations for the demo (2 = twice as fast).
PLAYBACK_SPEED=1

# ── Data ────────────────────────────────────────────
# Default: the 30 curated sample people (with scripted scenarios, best for demos).
# The team's generated 100k population — load it and work with a sample:
# PEOPLE_FILE=synthetic_population_100k.json
# PEOPLE_SAMPLE=30
# PEOPLE_SAMPLE_MODE=mixed     # mixed | risk | random
# PEOPLE_SAMPLE_SEED=7         # change for a different 30

# ── Scenario wording used by the AI ─────────────────
AGENCY_NAME=Cypress Bend Emergency Services
DISASTER_NAME=the earthquake

# ── Server ──────────────────────────────────────────
PORT=3001
