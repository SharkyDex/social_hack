# Copy this file to .env (in the repo root) and fill it in.
# .env is git-ignored — never commit real keys.

# ── AI ──────────────────────────────────────────────
# Groq API key. Leave empty to run in MOCK mode (scripted calls, no AI) —
# useful offline and as a demo fallback. One key only (the app does not rotate
# several keys — a comma-separated value would be treated as one invalid key).
GROQ_API_KEY=
# Model for the live conversation AND simulated calls. This is what to change
# if the conversation feels robotic — paying for Groq alone does NOT change it,
# only this does. 8b-instant is fast but weak at natural dialogue; a 17B is
# much better.
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   cheaper / faster fallback: GROQ_MODEL=llama-3.1-8b-instant

# Live WEB CALLS (talk to the AI from a real phone over the internet, no phone
# number — open /resident on the phone). Speech-to-text runs on Groq Whisper,
# so these need a GROQ_API_KEY. The reply is spoken by the phone's own TTS.
WHISPER_MODEL=whisper-large-v3-turbo
# Language the resident speaks: 'auto' detects it, or lock it (e.g. en, es, fr)
# for better accuracy in noise. Also hints the phone which TTS voice to use.
STT_LANGUAGE=auto

# ── Reasoning model for AFTER a live call ───────────────────
# Extraction (transcript -> findings) runs after the call, so latency doesn't
# matter and a stronger reasoning model is worth it. Any OpenAI-compatible
# endpoint. Leave REASONING_BASE_URL blank to use Groq for everything.
# Simulated AI-vs-AI calls always stay on Groq (won't spend this budget).
REASONING_BASE_URL=https://inference.baseten.co/v1
REASONING_API_KEY=
REASONING_MODEL=zai-org/GLM-5.3
# low keeps cost + latency down; high/max reason more but burn credit faster.
REASONING_EFFORT=low

# ── Phone calls & texts ─────────────────────────────
# simulated = everything happens in the app (no phone service, $0)
# twilio    = PLACEHOLDER — not implemented yet, see server/src/telephony/twilio.js
TELEPHONY_PROVIDER=simulated

# Safety net for live calling: when a real provider is on, EVERY outbound
# call and text goes to this number instead of the person's number.
DEMO_PHONE_NUMBER=

# Incoming calls ring this number first (meant to be 911 / the local PSAP).
# NEVER put 911 here while testing — use a teammate's phone.
INBOUND_FORWARD_NUMBER=
INBOUND_FORWARD_TIMEOUT_SECONDS=20

# Twilio placeholders (unused until the twilio provider is built)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=

# ── Welfare check behaviour ─────────────────────────
# voice = call people (texts only for Deaf / non-verbal)
# sms   = text everyone first — after an earthquake, texts often get through when calls don't
FIRST_CONTACT=voice
MAX_CALL_ATTEMPTS=3
# Seconds between retries. Short for the demo; minutes in real life.
RETRY_DELAY_SECONDS=8
# Reach the emergency contact after this many failed attempts.
CONTACT_EMERGENCY_AFTER_ATTEMPT=1
# How many welfare checks run at once during a round.
CHECK_CONCURRENCY=2
# Speed up simulated conversations for the demo (2 = twice as fast).
PLAYBACK_SPEED=1

# ── Data ────────────────────────────────────────────
# Default: the 30 curated sample people (with scripted scenarios, best for demos).
# The team's generated 100k population — load it and work with a sample:
# PEOPLE_FILE=synthetic_population_100k.json
# PEOPLE_SAMPLE=30
# PEOPLE_SAMPLE_MODE=mixed     # mixed | risk | random
# PEOPLE_SAMPLE_SEED=7         # change for a different 30

# ── Scenario wording used by the AI ─────────────────
AGENCY_NAME=Cypress Bend Emergency Services
DISASTER_NAME=the earthquake

# ── Server ──────────────────────────────────────────
PORT=3001

# ── 3D earthquake simulation (separate app) ─────────
# The simulation in simulation/ is its own Vite app with its OWN .env.
# Its Cesium ion token does NOT go here — set it there instead:
#   cd simulation  →  copy .env.example to .env  →  set VITE_CESIUM_ION_TOKEN
# Get a free token at https://ion.cesium.com/signup (Access Tokens page).
